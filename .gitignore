# ---------------------------------------------------------------------------
# Personal data. The *.example.* files are the templates that ship; the live
# files you create from them never get committed. Run scripts/setup.sh to
# create the live copies.
# ---------------------------------------------------------------------------
profile/*
!profile/.gitkeep
!profile/*.example.md

pipeline/*
!pipeline/.gitkeep
!pipeline/README.md
!pipeline/*.example.csv

drafts/*
!drafts/.gitkeep
!drafts/research/
drafts/research/*
!drafts/research/.gitkeep

# Generated documents
*.pdf
*.xlsx
*.html

# Local permission grants: machine-specific, and they authorise real tool access
.claude/settings.json
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# macOS
.DS_Store
